{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@entities/*": [
        "./src/entities/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@widgets/*": [
        "./src/widgets/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@app-root/*": [
        "./src/app-root/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "resolvePackageJsonExports": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
  ],
}