{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "resolvePackageJsonExports": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
  ],
}