{
  "expo": {
    "name": "Amy",
    "slug": "amy",
    "scheme": "amy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "locales": {
      "ru": "src/assets/ru.json"
    },
    "splash": {
      "image": "src/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "eas": {
        "projectId": "c9bd2255-8424-4267-ab5c-37fff7345abf"
      },
      "router": {}
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "src/assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": true,
      "package": "com.ilrosch.amy",
      "googleServicesFile": "google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "WAKE_LOCK",
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            {
              "fontFamily": "Roboto",
              "fontDefinitions": [
                {
                  "path": "src/assets/fonts/Roboto-Regular.ttf",
                  "weight": 400,
                  "style": "normal"
                },
                {
                  "path": "src/assets/fonts/Roboto-Medium.ttf",
                  "weight": 500,
                  "style": "normal"
                }
              ]
            }
          ]
        }
      ],
      ["expo-localization"],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": ["-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"]
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-background-task",
      "./plugins/withUsesFeatures",
      "@config-plugins/react-native-webrtc",
      [
        "react-native-full-screen-notification-incoming-call",
        {
          "statusBarColor": "#000000"
        }
      ]
    ],
    "owner": "ilrosch"
  }
}
